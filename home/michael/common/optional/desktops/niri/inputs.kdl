input {
	keyboard {
		repeat-delay 200
		repeat-rate 50
		numlock
        xkb { options "caps:swapescape"; }
	}

	touchpad { tap; }

	mouse { accel-profile "flat"; }

	trackpoint { accel-profile "flat"; }

	trackball { accel-profile "flat"; }

	disable-power-key-handling

	workspace-auto-back-and-forth
}
