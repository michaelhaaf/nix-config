//
// ========== Layer Rules ==========
//
layer-rule {
  match namespace="^noctalia-overview*"
  place-within-backdrop true
}
//
// ========== Layout Rules ==========
//
layout {
    background-color "transparent"
    center-focused-column "never"
    gaps 10
    default-column-width {
        proportion 0.66667
    }
    // Cycled though using `switch-preset-window-column` action
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        proportion 0.66667
        proportion 0.5
        proportion 0.33333
    }
    // Cycled though using `switch-preset-window-height` action
    preset-window-heights {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        proportion 1.0
        proportion 0.66667
        proportion 0.5
        proportion 0.33333
    }
    tab-indicator {
        // Set the gap between the tab indicator and the window in pixels.
        gap 0
        // Length of the indicator.
        length total-proportion=1.0
        // Whether to put the tab indicator "within" the column, rather than outside.
        // This will include it in column sizing and avoid overlaying adjacent columns.
        place-within-column
        // Position of the indicator.
        position "left"
        // Width of the tab indicator
        width 8
        // TODO: stylix colors
        active-color "#FF9400"
        inactive-color "#2D2D30"
    }
    struts {
        // Set a negative strut for the top and bottom to minimize wasted space.
        // Set a 1px wide strut on the sides to allow easy window switching with the mouse.
        left 0
        right 0
        top 0
        bottom 0
    }
}
//
// ========== Window Rules ==========
//
// ========== ALL windows ==========
window-rule {
    geometry-corner-radius 2
    clip-to-geometry true
    // focus ring configuration.
    focus-ring {
        off
        // Width of the focus ring in pixels.
        width 1

        // Color of the active focus ring.
        // TODO: stylix colors
        active-color "#FF9400"
        // Color of the inactive focus ring.
        inactive-color "#2D2D30"
        // Color of the focus ring around windows that request your attention.
        urgent-color "#C03900"
    }
}
// ========== Active windows ==========
window-rule {
    match is-active=true
    shadow {
        on
        softness 30
        spread 5
        // offset x= y=
        draw-behind-window true
        // required with non-squared corners
        // color "#FF9400"
        color "#0007"
    }
}
// ========== General transparency ==========
window-rule {
    match is-active=false
    opacity 0.85
}
// ========== Workspace Assignments ==========
window-rule {
    match app-id="signal"
    match app-id="vesktop"
    open-on-workspace "9_comms"
}
window-rule {
    match app-id="steam"
    open-on-workspace "5_steam"
}
window-rule {
    match app-id="com.yubico.yubioath"
    open-on-workspace "Y_qrs"
}
// ========== Float on open ==========
window-rule {
    // applications
    match app-id="galculator$"
    match app-id=r#"^Tk$"#
    match app-id=r#"^thunar$"#
    match app-id=r#"^wev$"#
    // dialog windows
    match title="^(Open File)(.*)$"
    match title="^(Select a File)(.*)$"
    match title="^(Choose wallpaper)(.*)$"
    match title="^(Open Folder)(.*)$"
    match title="^(Save As)(.*)$"
    match title="^(Library)(.*)$"
    match title="^(Accounts)(.*)$"
    match title="^(Text Import)(.*)$"
    match title="^(File Operation Progress)(.*)$"
    //may need to swap order of title and app-id for this one
    match title="^()$" app-id="^([Ff]irefox)"
    // specific app classes
    match app-id=r#"^floating\.ghostty$"#
    match app-id=r#"^floating\.thunar$"#
    // rules
    open-floating true
}
// ========== No Focus on open ==========
window-rule {
    match app-id="^([Ff]irefox)" title="^()$"
    open-focused false
}
// ========== Always opaque ==========
window-rule {
    // applications
    match title="^([Gg]imp)$"
    match title="^([Ff]lameshot)$"
    match title="^([Ii]nkscape)$"
    match title="^([Bb]lender)$"
    match title="^([Oo][Bb][Ss])$"
    match title="^([Ss]team)$"
    match title="^([Ss]team_app_*)$"
    match title="^([Vv]lc)$"
    match title="^(btop)(.*)$"
    match title="^(amdgpu_top)(.*)$"
    // remove transparency from video
    match title="^(Dashboard | glass*)(.*)"
    match title="^(Live video from*)(.*)$"
    match title="^(Netflix)(.*)$"
    match title="^(.*YouTube.*)$"
    match title="^(Picture-in-Picture)$"
    // rules
    opacity 1.0
}
// ========== Open at full width ==========
// Open certain windows in their full size.
window-rule {
    match app-id="^([Gg]imp)$"
    match app-id="^([Bb]lender)$"
    match app-id="^([Ii]nkscape)$"
    match app-id="^([Oo][Bb][Ss])$"
    default-column-width {
        proportion 1.0
    }
}
// ========== Varirable Refresh Rate ==========
// requires output to have `variable-refresh-rate on-demand=true`
window-rule {
    match app-id="^steam_app_.*$"
    match app-id="^([Vv]lc)$"
    variable-refresh-rate true
    // open-fullscreen true
}
// ========== Steam==========

window-rule {
    match title="^()$" app-id="^([Ss]team)$"
    match app-id="^([S]team_app_*)$"
    // TODO: put in nix config to adapt per host
    open-on-output "DP-3"
    open-on-workspace "5_gmz"
}
// ========== Signal ==========
// Resize certain windows to specific sizes.
window-rule {
    match app-id="^signal$"
    default-column-width {
        proportion 0.3333
    }
}
// Indicate screencasted windows with red colors.
window-rule {
    match is-window-cast-target=true

    focus-ring {
        active-color "#f38ba8"
        inactive-color "#7d0d2d"
    }

    border {
        inactive-color "#7d0d2d"
    }

    shadow {
        color "#7d0d2d70"
    }

    tab-indicator {
        active-color "#f38ba8"
        inactive-color "#7d0d2d"
    }
}
